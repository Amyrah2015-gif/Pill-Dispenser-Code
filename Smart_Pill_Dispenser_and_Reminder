/*
  Arduino smart pill dispenser prototype

  - Rotates the dispenser by an APPROXIMATE 45 degrees every 5 minutes.
  - Displays "Take your pill!" on a 16x2 LCD at reminder time.
  - Flashes the LED and sounds the buzzer as a reminder.

  IMPORTANT SERVO NOTE:
  This version is for a 360-degree CONTINUOUS-ROTATION servo.
  A continuous-rotation servo is controlled by speed and time, not by
  a requested angle. SERVO_45_DEGREES_MS must be calibrated for your
  particular motor and dispenser. Timing alone cannot guarantee an
  exact 45-degree movement. Test with harmless beads/paper tokens only.
*/

#include <Servo.h>
#include <LiquidCrystal.h>

// -------------------- Pin connections --------------------
const int servoPin  = 6;
const int ledPin    = 7;
const int buzzerPin = 8;

// LCD pins: RS, E, D4, D5, D6, D7
const int rs = 12;
const int en = 11;
const int d4 = 5;
const int d5 = 4;
const int d6 = 3;
const int d7 = 2;

Servo dispenserServo;
LiquidCrystal lcd(rs, en, d4, d5, d6, d7);

// -------------------- Timing settings --------------------
const unsigned long reminderInterval = 1UL * 60UL * 1000UL; // 1 minutes
const unsigned long reminderDisplayTime = 10000UL;          // show reminder for 10 seconds 

// -------------------- Continuous-rotation servo settings --------------------
// Most continuous-rotation servos stop near 90. Adjust if yours creeps.
const int SERVO_STOP = 90;

// 180 usually turns one direction; use 0 if it turns the wrong way.
const int SERVO_DIRECTION = 180;

// Starting estimate only. Calibrate this for your own servo.
// Increase this value for more rotation; decrease it for less rotation.
const unsigned long SERVO_45_DEGREES_MS = 1500;

unsigned long lastReminderTime = 0;
unsigned long reminderScreenEndTime = 0;
bool reminderIsShowing = false;

void setup() {
  pinMode(ledPin, OUTPUT);
  pinMode(buzzerPin, OUTPUT);

  digitalWrite(ledPin, LOW);
  digitalWrite(buzzerPin, LOW);

  dispenserServo.attach(servoPin);
  dispenserServo.write(SERVO_STOP); // make sure the servo is stopped

  lcd.begin(16, 2);
  showReadyScreen();

  // The first reminder will happen 5 minutes after the Arduino starts.
  lastReminderTime = millis();
}

void loop() {
  unsigned long now = millis();

  // Trigger once when each 5-minute interval has passed.
  if (now - lastReminderTime >= reminderInterval) {
    lastReminderTime = now;
    givePillReminder();

    reminderScreenEndTime = millis() + reminderDisplayTime;
    reminderIsShowing = true;
  }

  // Return to the ready screen after the reminder has been displayed.
  if (reminderIsShowing && (long)(millis() - reminderScreenEndTime) >= 0) {
    reminderIsShowing = false;
    showReadyScreen();
  }
}

void givePillReminder() {
  rotateApproximately45Degrees();

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Take your pill!");
  lcd.setCursor(0, 1);
  lcd.print("Reminder time");

  flashLEDAndBuzzer(4, 150);
}

void rotateApproximately45Degrees() {
  dispenserServo.write(SERVO_DIRECTION);  // rotate in the selected direction
  delay(SERVO_45_DEGREES_MS);              // run for the calibrated time
  dispenserServo.write(SERVO_STOP);       // stop the continuous-rotation servo
  delay(250);                              // short pause after movement
}

void flashLEDAndBuzzer(int numberOfFlashes, int flashDelayMs) {
  for (int i = 0; i < numberOfFlashes; i++) {
    digitalWrite(ledPin, HIGH);
    digitalWrite(buzzerPin, HIGH);
    delay(flashDelayMs);

    digitalWrite(ledPin, LOW);
    digitalWrite(buzzerPin, LOW);
    delay(flashDelayMs);
  }
}

void showReadyScreen() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Pill Dispenser");
  lcd.setCursor(0, 1);
  lcd.print("Ready - 5 min");
}
